---
import StrokeText from './StrokeText.jsx';
---

<section
  class="relative w-[100vw] left-[50%] right-[50%] -ml-[50vw] -mr-[50vw] overflow-hidden select-none transition-colors duration-300 bg-cover bg-center bg-no-repeat"
  style="background-image: url('/hero_background.jpg'); background-color: #F5EBDD; color: #ffffff;"
  aria-label="Hero"
  id="hero"
>
  <!-- Background Overlay (Removed heavy tint, keeping subtle gradient if needed for text legibility later, but currently clear) -->
  <div class="pointer-events-none absolute inset-0 z-0 bg-transparent"></div>

  <!-- Vertical dashed guide lines matching About/Expertise editorial grid -->
  <div class="pointer-events-none absolute inset-0 px-3 sm:px-6 lg:px-8 flex justify-between z-[1]">
    <div class="h-full w-px border-l border-dashed border-white/20"></div>
    <div class="h-full w-px border-r border-dashed border-white/20"></div>
  </div>

  <!-- Hero Content Structure (matching the provided image) -->
  <div class="relative z-10 w-full min-h-screen flex flex-col justify-end pb-12 lg:pb-20 px-6 sm:px-12 lg:px-24 mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-end w-full">
      
      <!-- Left Column: Title and Subtitle -->
      <div class="flex flex-col gap-4">
        <!-- StrokeText replaces the main H1 -->
        <div class="w-full max-w-md -ml-2">
          <StrokeText 
            client:load 
            text="SEVENINE" 
            strokeColor="#ffffff" 
            fillColor="#ffffff" 
            strokeWidth={1.2} 
            fontSize={96} 
            fontWeight={500} 
            letterSpacing={-2}
          />
        </div>
        <p class="text-2xl sm:text-3xl lg:text-4xl text-white font-medium tracking-wide -mt-2 drop-shadow-md">
          Unifying Pune's student community.
        </p>
        
        <div class="flex items-center gap-4 mt-8 lg:mt-16 text-sm text-white/80 tracking-wider font-medium">
          <span>Built for IB & IGCSE</span>
          <span>SEVENINE &copy; 2026</span>
        </div>
      </div>

      <!-- Right Column: Button and Body Text -->
      <div class="flex flex-col gap-6 lg:max-w-md ml-auto">
        <div>
          <a href="#community" class="inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#C17A5D] text-sm text-white font-medium hover:bg-[#5A767B] transition-colors shadow-lg">
            Start Exploring
          </a>
        </div>
        
        <p class="text-base sm:text-lg text-white/95 leading-relaxed font-medium drop-shadow-md">
          An exclusive platform that helps you explore extracurriculars deeper, ask sharper questions, and uncover collaborations that matter.
        </p>
        
        <p class="text-base sm:text-lg text-white/95 leading-relaxed font-medium drop-shadow-md">
          We go beyond school boundaries — connecting knowledge in real time, drawing from trusted academic peers, and guiding your journey with ambition and clarity.
        </p>
      </div>
      
    </div>
  </div>

  <!-- Scroll Hinter -->
  <div class="absolute bottom-8 left-[50%] -translate-x-[50%] flex flex-col items-center gap-3 z-10 opacity-70 hover:opacity-100 transition-opacity">
    <span class="text-[0.65rem] uppercase tracking-[0.2em] text-white font-medium drop-shadow-md">Scroll</span>
    <div class="w-[1px] h-10 bg-white/20 relative overflow-hidden rounded-full">
      <div class="absolute top-0 left-0 w-full h-full bg-white animate-scroll-line"></div>
    </div>
  </div>

  <style>
    @keyframes scrollLine {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(100%); }
    }
    .animate-scroll-line {
      animation: scrollLine 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
  </style>
</section>
