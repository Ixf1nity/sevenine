---
import Logo from './Logo.astro';

const navLinks = [
  { name: 'Why 7&9', href: '#about' },
  { name: 'What You Get', href: '#features' },
  { name: 'Join Network', href: '#community' },
];

const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://instagram.com/sevenine.in',
    icon: 'instagram',
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/company/sevenine',
    icon: 'linkedin',
  },
];
---

<footer
  x-data="{ legalModal: false, activeTab: 'trademark' }"
  class="relative mt-20 pt-16 pb-12 sm:pt-20 sm:pb-16 overflow-hidden border-t border-neutral-300/40 dark:border-white/10"
  aria-labelledby="footer-heading"
>
  <!-- Vertical dashed guide lines continuing the editorial grid -->
  <div class="pointer-events-none absolute inset-0 px-3 sm:px-6 lg:px-8 flex justify-between">
    <div class="h-full w-px border-l border-dashed border-neutral-300/40 dark:border-white/10"></div>
    <div class="h-full w-px border-r border-dashed border-neutral-300/40 dark:border-white/10"></div>
  </div>

  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="relative mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class="flex flex-col justify-between gap-12 lg:flex-row lg:items-start">
      <!-- Brand & Tagline -->
      <div class="flex max-w-md flex-col items-start gap-5">
        <a href="#" aria-label="SEVENINE - 79 | sevenine.in">
          <Logo size="md" />
        </a>
        <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base leading-relaxed">
          Academic & Social Exchange Platform built exclusively for IB & IGCSE students in Pune. Bridging the IB 7-point and IGCSE 9-point scales.
        </p>
        <p class="text-neutral-500 dark:text-neutral-500 text-xs">
          © 2026 SEVENINE (sevenine.in). All rights reserved.
        </p>
      </div>

      <!-- Navigation & Socials Columns -->
      <div class="flex flex-wrap items-start gap-12 sm:gap-16">
        <!-- In-page Navigation -->
        <div class="flex flex-col gap-4">
          <p class="text-xs uppercase tracking-[0.18em] font-semibold text-neutral-900 dark:text-white">
            Navigation
          </p>
          <ul role="list" class="flex flex-col gap-2.5">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition-colors"
                  >
                    {link.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Legal & Compliance (On-Page Modals) -->
        <div class="flex flex-col gap-4">
          <p class="text-xs uppercase tracking-[0.18em] font-semibold text-neutral-900 dark:text-white">
            Legal & Trust
          </p>
          <ul role="list" class="flex flex-col gap-2.5 text-sm">
            <li>
              <button
                type="button"
                @click="legalModal = true; activeTab = 'trademark'"
                class="text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white text-left transition-colors cursor-pointer"
              >
                Trademark & Affiliation
              </button>
            </li>
            <li>
              <button
                type="button"
                @click="legalModal = true; activeTab = 'integrity'"
                class="text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white text-left transition-colors cursor-pointer"
              >
                Academic Integrity Policy
              </button>
            </li>
            <li>
              <button
                type="button"
                @click="legalModal = true; activeTab = 'privacy'"
                class="text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white text-left transition-colors cursor-pointer"
              >
                Privacy & Safety
              </button>
            </li>
            <li>
              <button
                type="button"
                @click="legalModal = true; activeTab = 'terms'"
                class="text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white text-left transition-colors cursor-pointer"
              >
                Terms of Use
              </button>
            </li>
          </ul>
        </div>

        <!-- Social Connections -->
        <div class="flex flex-col gap-4">
          <p class="text-xs uppercase tracking-[0.18em] font-semibold text-neutral-900 dark:text-white">
            Connect
          </p>
          <ul role="list" class="flex flex-col gap-3">
            {
              socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition-colors group"
                  >
                    {link.icon === 'instagram' && (
                      <svg class="w-4 h-4 text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                      </svg>
                    )}
                    {link.icon === 'linkedin' && (
                      <svg class="w-4 h-4 text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                        <rect x="2" y="9" width="4" height="12"></rect>
                        <circle cx="4" cy="4" r="2"></circle>
                      </svg>
                    )}
                    <span>{link.name}</span>
                    <svg class="w-3 h-3 opacity-60 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

      </div>
    </div>

    <!-- Mandatory Legal Non-Affiliation Disclaimer Banner -->
    <div class="mt-12 pt-6 border-t border-neutral-300/40 dark:border-white/10 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-4xl space-y-2">
      <p>
        <strong class="font-semibold text-neutral-700 dark:text-neutral-300">Mandatory Non-Affiliation & Trademark Disclaimer:</strong> SEVENINE (sevenine.in) is an independent peer collaboration community organized by and for students in Pune, India. SEVENINE is not affiliated with, associated with, authorized by, sponsored by, or endorsed by the International Baccalaureate Organization (IBO) or Cambridge Assessment International Education (CAIE).
      </p>
      <p>
        "International Baccalaureate", "IB", and the IB logo are registered trademarks of the International Baccalaureate Organization. "Cambridge", "IGCSE", and related marks are registered trademarks of Cambridge Assessment International Education / University of Cambridge. All references to IB, IGCSE, IA, EE, CAS, and TOK are made solely for nominative, descriptive, and identification purposes under fair use doctrine.
      </p>
    </div>
  </div>

  <!-- Giant Enlarged Logo: subtle edge-to-edge footer branding -->
  <div class="mt-12 sm:mt-16 pt-8 border-t border-neutral-300/30 dark:border-white/5 px-4 sm:px-6 lg:px-8 select-none">
    <div class="mx-auto max-w-7xl opacity-80 hover:opacity-100 transition-opacity">
      <svg
        viewBox="0 0 1020 135"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full h-auto block"
        aria-label="79 | sevenine.in"
      >
        <defs>
          <linearGradient id="footer-logo-grad-79-lg" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#1b90ff" />
            <stop offset="100%" stop-color="#ff551f" />
          </linearGradient>
          <linearGradient id="footer-logo-grad-sevenine-lg" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#1b90ff" />
            <stop offset="100%" stop-color="#ff551f" />
          </linearGradient>
        </defs>

        <text
          x="0"
          y="115"
          font-family="Poppins, sans-serif"
          font-weight="400"
          font-size="142"
          letter-spacing="-28.4"
          fill="url(#footer-logo-grad-79-lg)"
        >79</text>

        <text
          x="195"
          y="112"
          font-family="Poppins, sans-serif"
          font-weight="300"
          font-size="135"
          fill="currentColor"
          class="text-neutral-400 dark:text-neutral-600 opacity-40"
        >|</text>

        <text
          x="248"
          y="115"
          font-family="Poppins, sans-serif"
          font-weight="400"
          font-size="142"
          letter-spacing="-7.1"
          fill="url(#footer-logo-grad-sevenine-lg)"
        >sevenine.in</text>
      </svg>
    </div>
  </div>

  <!-- Single-Page Interactive Legal Modal -->
  <div
    x-cloak
    x-show="legalModal"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-6 overflow-y-auto bg-black/70 backdrop-blur-md"
    @keydown.escape.window="legalModal = false"
  >
    <div
      @click.away="legalModal = false"
      class="relative w-full max-w-3xl rounded-3xl bg-white dark:bg-[#121418] text-neutral-900 dark:text-neutral-100 shadow-2xl border border-black/10 dark:border-white/10 overflow-hidden flex flex-col max-h-[85vh]"
    >
      <!-- Modal Header -->
      <div class="px-6 py-5 border-b border-black/10 dark:border-white/10 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <Logo size="sm" />
          <span class="text-xs uppercase tracking-wider font-semibold text-neutral-500">Legal Documentation</span>
        </div>
        <button
          type="button"
          @click="legalModal = false"
          class="text-neutral-500 hover:text-neutral-950 dark:hover:text-white p-1 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition"
          aria-label="Close legal modal"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Tab Buttons -->
      <div class="flex border-b border-black/10 dark:border-white/10 overflow-x-auto px-6 gap-2 bg-neutral-50 dark:bg-[#171a20]">
        <button
          type="button"
          @click="activeTab = 'trademark'"
          class="py-3 px-3 text-xs sm:text-sm font-medium border-b-2 transition whitespace-nowrap"
          :class="activeTab === 'trademark' ? 'border-primary-600 text-primary-600 dark:border-primary-400 dark:text-primary-400 font-semibold' : 'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200'"
        >
          Trademark & Affiliation
        </button>
        <button
          type="button"
          @click="activeTab = 'integrity'"
          class="py-3 px-3 text-xs sm:text-sm font-medium border-b-2 transition whitespace-nowrap"
          :class="activeTab === 'integrity' ? 'border-primary-600 text-primary-600 dark:border-primary-400 dark:text-primary-400 font-semibold' : 'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200'"
        >
          Academic Integrity
        </button>
        <button
          type="button"
          @click="activeTab = 'privacy'"
          class="py-3 px-3 text-xs sm:text-sm font-medium border-b-2 transition whitespace-nowrap"
          :class="activeTab === 'privacy' ? 'border-primary-600 text-primary-600 dark:border-primary-400 dark:text-primary-400 font-semibold' : 'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200'"
        >
          Privacy & Safety
        </button>
        <button
          type="button"
          @click="activeTab = 'terms'"
          class="py-3 px-3 text-xs sm:text-sm font-medium border-b-2 transition whitespace-nowrap"
          :class="activeTab === 'terms' ? 'border-primary-600 text-primary-600 dark:border-primary-400 dark:text-primary-400 font-semibold' : 'border-transparent text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200'"
        >
          Terms of Service
        </button>
      </div>

      <!-- Tab Content Area -->
      <div class="p-6 sm:p-8 overflow-y-auto space-y-4 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
        <!-- Tab 1: Trademark -->
        <div x-show="activeTab === 'trademark'" class="space-y-4">
          <h3 class="text-base font-bold text-neutral-900 dark:text-white">Trademark Non-Affiliation Statement</h3>
          <p>
            SEVENINE (sevenine.in) is an independent peer-to-peer student exchange and academic networking platform established in Pune, Maharashtra, India.
          </p>
          <p>
            <strong>Zero Official Affiliation:</strong> SEVENINE is not affiliated with, endorsed by, approved by, authorized by, sponsored by, or in any way officially connected with:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li>The International Baccalaureate Organization (IBO, Geneva/Cardiff/Singapore)</li>
            <li>Cambridge University Press & Assessment / Cambridge Assessment International Education (CAIE, UK)</li>
            <li>Any specific school or testing administration authority unless explicitly certified under a mutual written agreement.</li>
          </ul>
          <p>
            "International Baccalaureate", "IB", "IB Diploma Programme", "MYP", and related emblems are registered trademarks owned exclusively by the International Baccalaureate Organization. "Cambridge", "IGCSE", "O-Level", and "A-Level" are registered trademarks owned by Cambridge Assessment International Education. All references to curricula, syllabus codes, and grading bands (such as the 7-point scale or 9-point scale) are strictly nominative references for educational descriptive accuracy.
          </p>
        </div>

        <!-- Tab 2: Integrity -->
        <div x-show="activeTab === 'integrity'" class="space-y-4">
          <h3 class="text-base font-bold text-neutral-900 dark:text-white">Academic Integrity & Anti-Plagiarism Policy</h3>
          <p>
            SEVENINE is built to foster intellectual curiosity, discussion, and legitimate peer support. We strictly prohibit any activities that compromise academic honesty.
          </p>
          <p><strong>Prohibited Actions on SEVENINE:</strong></p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Plagiarism & Ghostwriting:</strong> Soliciting, producing, purchasing, or selling coursework, completed Internal Assessments (IA), Extended Essays (EE), Theory of Knowledge (TOK) essays, or IGCSE portfolios.</li>
            <li><strong>Confidential Examination Content:</strong> Uploading or soliciting live exam papers, leaked mark schemes, or confidential test materials prior to official public release.</li>
            <li><strong>Impersonation:</strong> Presenting another student's original experimental data or intellectual findings as one's own.</li>
          </ul>
          <p>
            Violators are subject to immediate account termination, content removal, and reporting to relevant institution coordinators where legally required.
          </p>
        </div>

        <!-- Tab 3: Privacy -->
        <div x-show="activeTab === 'privacy'" class="space-y-4">
          <h3 class="text-base font-bold text-neutral-900 dark:text-white">Student Privacy Safeguards</h3>
          <p>
            Protecting high school students and underage participants is fundamental to SEVENINE:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Voluntary Disclosures:</strong> Students retain total control over what is visible on their public profile (e.g., subject choices, predicted milestones, or sports interests).</li>
            <li><strong>No Data Brokering:</strong> SEVENINE does not sell, rent, or trade student profiles, phone numbers, or academic data to third-party commercial tutoring mills or advertising aggregators.</li>
            <li><strong>Moderation:</strong> All open exchange channels are monitored by senior peer moderators and verified student leads to prevent harassment, trolling, or spam.</li>
          </ul>
        </div>

        <!-- Tab 4: Terms -->
        <div x-show="activeTab === 'terms'" class="space-y-4">
          <h3 class="text-base font-bold text-neutral-900 dark:text-white">Terms of Use & Limitation of Liability</h3>
          <p>
            <strong>1. Service Provided "As-Is":</strong> SEVENINE is provided on an "as-is" and "as-available" basis for informational, community, and networking convenience.
          </p>
          <p>
            <strong>2. Academic Disclaimer:</strong> Advice, feedback, predictions, or study materials shared by community members represent individual student opinions only. SEVENINE makes no warranty regarding academic grades, diploma awards, examination outcomes, or university admissions decisions.
          </p>
          <p>
            <strong>3. User Conduct:</strong> By accessing sevenine.in, users agree to treat all peers with dignity, maintain respectful discourse, and comply with all applicable local and national laws.
          </p>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-4 bg-neutral-50 dark:bg-[#171a20] border-t border-black/10 dark:border-white/10 flex justify-end">
        <button
          type="button"
          @click="legalModal = false"
          class="rounded-full bg-neutral-900 hover:bg-black dark:bg-white dark:hover:bg-neutral-200 text-white dark:text-neutral-950 px-5 py-2 text-xs font-semibold transition"
        >
          Understood & Close
        </button>
      </div>
    </div>
  </div>
</footer>
