---
import Logo from './Logo.astro';

interface Props {
  links?: { name: string; href: string }[];
}

const defaultLinks = [
  { name: 'Why 7&9', href: '#about' },
  { name: 'What You Get', href: '#features' },
  { name: 'Join Network', href: '#community' },
];

const { links = defaultLinks } = Astro.props;
---

<header
  x-data="{ open: false }"
  class="fixed top-0 left-0 right-0 z-50 w-full pt-4 sm:pt-6 px-4 sm:px-6 pointer-events-none transition"
>
  <div class="mx-auto max-w-4xl lg:max-w-5xl pointer-events-auto">
    <!-- Floating Capsule Pill Container -->
    <div
      class="rounded-full bg-white/95 dark:bg-[#16181e]/95 backdrop-blur-md border border-black/[0.08] dark:border-white/10 shadow-[0_4px_24px_rgba(0,0,0,0.06)] px-4 sm:px-6 py-2 sm:py-2.5 flex items-center justify-between transition"
    >
      <!-- Left: Brand Logo -->
      <a
        href="#"
        class="flex items-center py-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-full"
        aria-label="SEVENINE Home"
      >
        <Logo size="sm" />
      </a>

      <!-- Center: Navigation Links (Desktop) -->
      <nav class="hidden md:flex items-center gap-7 lg:gap-9" aria-label="Main navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-neutral-600 hover:text-neutral-950 dark:text-neutral-300 dark:hover:text-white transition-colors duration-150"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- Right: Action Buttons -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <!-- Join Now pill button -->
        <a
          href="#community"
          class="inline-flex items-center gap-1.5 rounded-full bg-[#35373b] hover:bg-[#1e2023] dark:bg-white dark:hover:bg-neutral-200 text-white dark:text-neutral-950 px-4 sm:px-5 py-2 text-xs sm:text-sm font-medium transition duration-200 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neutral-800"
        >
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
          <span>Join Now</span>
        </a>



        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          class="md:hidden text-neutral-600 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white h-8 w-8 inline-flex items-center justify-center rounded-full transition focus:outline-none"
          @click="open = !open"
          aria-label="Toggle navigation menu"
        >
          <svg
            x-cloak
            class="h-5 w-5"
            :class="{ 'hidden': open, 'block': !open }"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            x-cloak
            class="h-5 w-5"
            :class="{ 'block': open, 'hidden': !open }"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div
      x-cloak
      x-show="open"
      x-collapse
      class="mt-2 md:hidden rounded-2xl bg-white/95 dark:bg-[#16181e]/95 backdrop-blur-md border border-black/[0.08] dark:border-white/10 shadow-lg p-4"
    >
      <nav class="flex flex-col gap-2" aria-label="Mobile navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              @click="open = false"
              class="px-3 py-2 rounded-xl text-base font-medium text-neutral-700 hover:bg-black/5 dark:text-neutral-200 dark:hover:bg-white/5 transition"
            >
              {link.name}
            </a>
          ))
        }
      </nav>
      <div class="pt-3 mt-2 border-t border-black/10 dark:border-white/10 flex flex-col gap-2.5">
        <a
          href="#community"
          @click="open = false"
          class="w-full text-center py-2.5 rounded-xl bg-[#1f242e] text-white dark:bg-white dark:text-neutral-950 font-medium text-sm transition"
        >
          Join Now ↗
        </a>
        <div class="flex items-center justify-center gap-4 text-xs text-neutral-500 dark:text-neutral-400">
          <a href="https://instagram.com/sevenine.in" target="_blank" rel="noopener noreferrer" class="hover:underline">Instagram</a>
          <span>•</span>
          <a href="https://linkedin.com/company/sevenine" target="_blank" rel="noopener noreferrer" class="hover:underline">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
</header>
